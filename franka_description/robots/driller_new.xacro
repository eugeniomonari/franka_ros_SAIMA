<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="driller_new">
  <!-- safety_distance: Minimum safety distance in [m] by which the collision volumes are expanded and which is enforced during robot motions -->
  <xacro:macro name="driller_new" params="connected_to:='' ns:='' rpy:='0 0 0' xyz:='0 0 0' safety_distance:=0">
    <xacro:unless value="${connected_to == ''}">
      <joint name="${ns}_driller_new_joint" type="fixed">
        <parent link="${connected_to}"/>
        <child link="${ns}_driller_new"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
      </joint>
    </xacro:unless>
    <link name="${ns}_driller_new">
      <visual>
        <geometry>
          <mesh filename="package://franka_description/meshes/visual/driller_new_m.stl"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 -0.051 0.0425"/>
        <geometry>
            <box size="0.082 0.25 0.09"/>
        </geometry>
    </collision>
    <collision>
        <origin rpy="0 0 0" xyz="0 -0.1395 0.107"/>
        <geometry>
            <box size="0.32 0.068 0.214"/>
        </geometry>
    </collision>
    </link>    
    
  </xacro:macro>
</robot>
